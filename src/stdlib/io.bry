--!

io.bry

Bery Standard Library for Input/Output

!--

extern func __bery_print_int(int value);
extern func __bery_print_bigint(bigint value);
extern func __bery_print_float(float value);
extern func __bery_print_double(double value);
extern func __bery_print_bool(bool value);
extern func __bery_print_char(char value);
extern func __bery_print_string(string value);
extern func bery_println();

extern func __bery_input_int(string prompt) -> int;
extern func __bery_input_bigint(string prompt) -> bigint;
extern func __bery_input_float(string prompt) -> float;
extern func __bery_input_double(string prompt) -> double;
extern func __bery_input_bool(string prompt) -> bool;
extern func __bery_input_char(string prompt) -> char;
extern func bery_input(string prompt) -> string;




func print(int value)    { __bery_print_int(value); }
func print(bigint value) { __bery_print_bigint(value); }
func print(float value)  { __bery_print_float(value); }
func print(double value) { __bery_print_double(value); }
func print(bool value)   { __bery_print_bool(value); }
func print(char value)   { __bery_print_char(value); }
func print(string value) { __bery_print_string(value); }


func println() { bery_println(); }
func println(int value)    { __bery_print_int(value);    bery_println(); }
func println(bigint value) { __bery_print_bigint(value); bery_println(); }
func println(float value)  { __bery_print_float(value);  bery_println(); }
func println(double value) { __bery_print_double(value); bery_println(); }
func println(bool value)   { __bery_print_bool(value);   bery_println(); }
func println(char value)   { __bery_print_char(value);   bery_println(); }
func println(string value) { __bery_print_string(value); bery_println(); }

func inputInt(string prompt) -> int       { return __bery_input_int(prompt); }
func inputBigInt(string prompt) -> bigint { return __bery_input_bigint(prompt); }
func inputFloat(string prompt) -> float   { return __bery_input_float(prompt); }
func inputDouble(string prompt) -> double { return __bery_input_double(prompt); }
func inputBool(string prompt) -> bool     { return __bery_input_bool(prompt); }
func inputChar(string prompt) -> char     { return __bery_input_char(prompt); }
func inputString(string prompt) -> string { return bery_input(prompt); }

run {}